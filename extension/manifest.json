{
  "manifest_version": 3,
  "name": "Post-Solve Mistake Ledger",
  "version": "1.1",
  "description": "Sits beside LeetCode, watches the coding phase silently, and explains only after Analyze.",
  "permissions": ["storage", "sidePanel", "tabs", "alarms"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content-script.js"]
    }
  ],
  "action": {
    "default_title": "Mistake Ledger"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
